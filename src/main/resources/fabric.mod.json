{
	"schemaVersion": 1,
	"id": "fishing-rcblock",
	"version": "${version}",
	"name": "fishing-rcblock",
	"description": "Blocks rightclicks when Carrot King or Water Hydra was caught",
	"authors": [
		"Lennyverse"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/fishing-rcblock/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.lennyverse.rcblock.FishingRcblock"
		],
		"client": [
			"com.lennyverse.rcblock.client.FishingRcblockClient"
		]
	},
	"mixins": [
		"fishing-rcblock.mixins.json",
		{
			"config": "fishing-rcblock.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}